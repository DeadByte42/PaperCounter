			</Grid.ColumnDefinitions>
			<Rectangle RadiusX="10" RadiusY="10" Stroke="LightGray" StrokeDashArray="5,2" StrokeThickness="5" Grid.ColumnSpan="6"/>
			<Viewbox Margin="5" Grid.Column="1">
